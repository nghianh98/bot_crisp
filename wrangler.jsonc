{
  // Bot production. Bot cũ "transtore-bot" (code sửa trên dashboard) đã ẩn ngày 13/11/2026: tắt URL workers.dev và cron,
  // giữ nguyên code, khoá và lịch sử deploy để quay lại khi cần. Không config nào ở đây deploy vào nó nữa.
  "name": "transtore-bot-prod",
  "main": "src/worker.js",
  // Đẩy lên y nguyên từng file trong src/ (không gộp), để editor trên dashboard vẫn thấy đúng cây thư mục.
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "src",
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js"] }
  ],
  // Giao diện /admin (React, mã nguồn ở admin-ui/). Trước mỗi lần dev/deploy wrangler tự chạy `npm run build`
  // để gói giao diện vào build/, rồi đưa build/ lên cùng Worker. watch_dir: khi `npm run dev`, sửa file ở src/ hay
  // admin-ui/ đều nạp lại (thiếu "src" thì sửa code Worker không được nạp lại). run_worker_first: mọi request đi qua
  // Worker trước, nên phải đăng nhập mới tải được giao diện (xem src/admin/ui.js).
  "build": { "command": "npm run build", "watch_dir": ["src", "admin-ui"] },
  "assets": { "directory": "./build", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-11",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true }, // tab Issues trên dashboard (gom lỗi); đang bật trên Cloudflare, giữ cho khớp
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // Giữ biến đặt trên dashboard khi deploy (chỉ giữ được biến có trong bản upload gần nhất).
  // Khoá bí mật (CRISP_*, ADMIN_KEY…) hãy đặt dạng Secret: deploy không bao giờ xoá secret.
  "keep_vars": true,
  // Giờ làm việc không đặt ở đây nữa: team chọn trên /admin → Settings → Working hours (lưu trong KV).
  // Biến BUSINESS_HOURS cũ đã xoá trên dashboard ngày 21/11/2026; để lại ở đây thì mỗi lần deploy nó lại được tạo ra.
  "vars": {
    "SUPPORT_EMAIL": "support@transtore.app"
  },
  // Mỗi hội thoại 1 Durable Object lo việc trả lời khách (src/conversation.js): không bị giới hạn 30 giây sau webhook,
  // nên AI được nghĩ kỹ hơn. Deploy tự tạo, không phải làm gì thêm trên dashboard. Dùng được cả gói Free (loại SQLite).
  // Bỏ 2 mục này thì bot vẫn chạy, theo cách cũ (trả lời trong 30 giây).
  "durable_objects": { "bindings": [{ "name": "CONV", "class_name": "Conversation" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }],
  "kv_namespaces": [
    {
      "id": "8dfd5426a1414f89a37d1b2fe4a80237",
      "binding": "KB"
    }
  ]
}