{
  "name": "transtore-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm test && vite build --config vite.config.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:ui": "vite --config vite.config.mjs",
    "start": "wrangler dev",
    "check": "npm test && wrangler deploy --dry-run --outdir dist",
    "test": "node --test",
    "logs": "wrangler tail",
    "versions": "wrangler versions list"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  }
}
