{
  // Mẫu config để chạy bot này cho MỘT APP KHÁC (mỗi app = 1 worker + 1 kho dữ liệu KV riêng).
  // Cách dùng: xem README.md → "Dùng bot cho app khác".
  //   1. Chép file này thành wrangler.<tên-app>.jsonc
  //   2. Sửa "name" và "id" của KV bên dưới
  //   3. npx wrangler deploy -c wrangler.<tên-app>.jsonc
  // Không có nội dung riêng của app nào trong code: tên sản phẩm, help center, giờ làm việc, múi giờ,
  // cách trả lời… đều điền trên trang /admin của worker mới.
  "name": "myapp-support-bot",
  "main": "src/worker.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "src",
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js"] }
  ],
  // Giao diện /admin: wrangler tự chạy `npm run build` (gói admin-ui/ vào build/) rồi đưa build/ lên cùng Worker.
  "build": { "command": "npm run build", "watch_dir": ["src", "admin-ui"] },
  "assets": { "directory": "./build", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-11",
  "triggers": {
    "crons": [
      "* * * * *" // mỗi phút: sync kiến thức, nhắc khách, câu trả lời hẹn
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }
  },
  "keep_vars": true,
  // Mỗi hội thoại 1 Durable Object lo việc trả lời khách (src/conversation.js): không bị giới hạn 30 giây sau webhook,
  // nên AI được nghĩ kỹ hơn. Deploy tự tạo, không phải làm gì thêm trên dashboard. Dùng được cả gói Free (loại SQLite).
  // Bỏ 2 mục này thì bot vẫn chạy, theo cách cũ (trả lời trong 30 giây).
  "durable_objects": { "bindings": [{ "name": "CONV", "class_name": "Conversation" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }],
  "kv_namespaces": [
    {
      "id": "DÁN_ID_KV_CỦA_APP_MỚI_VÀO_ĐÂY", // lấy từ lệnh: npx wrangler kv namespace create <tên-app>-bot-kb
      "binding": "KB"
    }
  ]
}
